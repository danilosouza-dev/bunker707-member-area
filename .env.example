NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
BUNKER_AI_GATEWAY_URL=
BUNKER_AI_GATEWAY_API_KEY=
BUNKER_AI_GATEWAY_MANAGEMENT_KEY=

# Validacao de sessao no proxy.ts: "user" (padrao, getUser consulta o Auth a cada request)
# ou "claims" (getClaims valida o JWT localmente via JWKS quando o projeto Supabase usa
# signing keys assimetricas; sem elas o getClaims ainda chama o Auth). Ative "claims"
# primeiro no staging, depois de migrar as signing keys.
AUTH_SESSION_STRATEGY=

# Extracao nao oficial de faixas do YouTube (qualidade manual na aula e no Modo TV).
# Valores: on | off. Vazio ou ausente = on (padrao da fase 0, comportamento atual).
# Qualquer outro valor desliga. Com off, as rotas de faixas respondem 404 e o player
# fica so no embed oficial em qualidade automatica; legendas e transcricao seguem ativas.
YOUTUBE_UNOFFICIAL_STREAMS=

# Token Bearer da rota POST /api/jobs/tick, chamada a cada minuto pelo pg_cron + pg_net.
# Gere com `openssl rand -hex 32` (minimo de 32 caracteres) e grave o mesmo valor no
# Vault do Supabase como `jobs_tick_token` (passos em supabase/migrations/202610100001_jobs_cron.sql).
JOBS_TICK_TOKEN=

# Observabilidade (docs/06-seguranca-operacao.md, secao Observabilidade). Tudo opcional: sem as
# variaveis abaixo o navegador so carrega o Vercel Speed Insights (ativado no painel da Vercel).
# Variaveis NEXT_PUBLIC_* entram no bundle no build: depois de mudar, faca novo deploy.
#
# PostHog (analytics de produto). Chave publica do projeto (phc_...), nao e segredo. Vazio = desligado.
NEXT_PUBLIC_POSTHOG_KEY=
# Host de ingestao. Vazio = https://us.i.posthog.com (regiao UE: https://eu.i.posthog.com).
NEXT_PUBLIC_POSTHOG_HOST=
#
# Sentry (erros e amostra de 10% de performance). DSN do servidor Node.js/Edge; vazio = usa
# NEXT_PUBLIC_SENTRY_DSN; os dois vazios = Sentry desligado no servidor.
SENTRY_DSN=
# DSN do navegador (publico por natureza). Vazio = Sentry desligado no cliente e fora da CSP.
NEXT_PUBLIC_SENTRY_DSN=
# Opcional: nome do ambiente no Sentry. Vazio = VERCEL_ENV ou NODE_ENV.
SENTRY_ENVIRONMENT=
# Upload de source maps entra com withSentryConfig no next.config.ts (fase seguinte). SENTRY_AUTH_TOKEN
# e segredo de build: so no painel da Vercel/CI, nunca com prefixo NEXT_PUBLIC_.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Numeros SIMULADOS no admin (Visao geral e colunas de alunos de Produtos), so para conferir layout no
# localhost. Valores: on | off. Ignorado em producao (NODE_ENV=production).
ADMIN_DEMO_DATA=

# E-mail transacional (docs/06, secao E-mail transacional; decisao em docs/19 secao 2). Provedor atual:
# Resend, atras de adaptador (src/server/email); Amazon SES entra na segunda rodada sem mudar quem dispara.
# Quem dispara (venda por webhook, Adicionar aluno, importacao) so enfileira em email_outbox; o job
# `email-outbox` do tick de minuto envia. Valores de EMAIL_PROVIDER: resend | none. Vazio = none: nada e
# enviado, os e-mails ficam na fila com log e expiram em 7 dias (dev e previews nao quebram).
EMAIL_PROVIDER=
# Chave de envio do Resend (permissao "Sending access"). So no servidor; sem ela o provedor vira none.
RESEND_API_KEY=
# Segredo (whsec_...) do endpoint de webhook do Resend apontado para POST /api/webhooks/resend.
# Sem ele a rota responde 503 e nenhum evento e gravado.
RESEND_WEBHOOK_SECRET=
# Remetente e Reply-To. Vazios = "Bunker707 <equipe@mail.bunker707.com.br>" (dominio verificado no Resend)
# e "contato@bunker707.com.br". EMAIL_REPLY_TO=none desliga o Reply-To.
EMAIL_FROM=
EMAIL_REPLY_TO=
# Teto de e-mails que o app envia por dia (calendario UTC). Vazio = 90, abaixo dos 100/dia do Resend
# Free. Os e-mails do Supabase Auth (SMTP) consomem a mesma cota do Resend, mas nao entram nesta conta.
EMAIL_DAILY_LIMIT=
# Origem publica do site (ex.: https://app.bunker707.com.br) para os links dos e-mails e do convite.
# Vazia = cabecalhos do request (Vercel atras de proxy) e, nos e-mails, a origem de quem disparou.
NEXT_PUBLIC_SITE_URL=

# Webinarios, a sala ao vivo (docs/30 §5.3, §5.4, §6.3, §6.7 e §7.3). Tudo so no servidor: nada aqui vai para o
# navegador nem leva NEXT_PUBLIC_. Sem WEBINAR_MEET_DOMAIN ou sem WEBINAR_JWT_SECRET a sala ao vivo mostra "em breve"
# e nada quebra (a Live gravada e o Replay continuam).
# Hostname do Jitsi proprio (servidor C), sem https:// (ex.: meet.bunker707.com.br). Tambem lido no build pela
# Permissions-Policy de /webinarios e do console da sala (next.config.ts); sem ele no build vale meet.bunker707.com.br.
WEBINAR_MEET_DOMAIN=
# iss/aud do token da sala; o mesmo JWT_APP_ID do .env do Jitsi. Vazio = bunker707.
WEBINAR_JWT_APP_ID=
# Segredo HS256 do token da sala (minimo de 32 caracteres; `openssl rand -hex 32`): o mesmo JWT_APP_SECRET do Jitsi.
WEBINAR_JWT_SECRET=
# Segredo do webhook do gravador (POST /api/webhooks/recorder; HMAC de "timestamp.corpo", minimo de 32 caracteres):
# o mesmo valor que a maquina do gravador recebe pelo segredo JIBRI_SECRETS do repositorio. Sem ele a rota responde 401.
WEBINAR_RECORDER_WEBHOOK_SECRET=
# Opcional: token do GitHub so com "Actions: write" deste repositorio, para o app pedir e devolver a maquina do
# gravador (workflow infra.yml, etapas jibri-up/jibri-down). Vazio = o console mostra a reserva (Gravar no navegador /
# Enviar gravacao) e o pedido fica para a equipe tecnica.
GITHUB_INFRA_TOKEN=
# Opcional, so fora da producao: "fake" troca o pedido ao GitHub por um duble que so anota (testes de ponta a ponta).
WEBINAR_RECORDER_DISPATCH=
# Opcionais: chave de API e biblioteca da Bunny Stream para o job webinar-recordings consultar a codificacao do video
# gravado (ate ready), ler a duracao e apagar na Bunny o que passou da retencao. Vazias = a gravacao fica em
# processamento ate a equipe ligar o video pelo console.
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_LIBRARY_ID=
