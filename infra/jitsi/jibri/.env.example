############################################################################################
# Gravador (Jibri) da Bunker707, servidor por hora bunker707-jibri-<sessao>: variaveis de
# infra/jitsi/jibri/docker-compose.yml.
#
# NAO edite este arquivo com valores reais e nao gere o .env a mao: a etapa jibri-up (infra/cloud/jibri.sh)
# copia este exemplo para /opt/jibri/.env na maquina nova e grava cada valor por SSH (chmod 600): os
# dominios, as senhas do Jibri e o endereco publico vem do .env do servidor C; a sessao e o tipo vem das
# opcoes da etapa; a chave da Bunny e o segredo do webhook vem do segredo JIBRI_SECRETS do repositorio
# (docs/20 §8B.3). Nenhum valor passa pelo cloud-init nem pelo log.
############################################################################################

############
# Imagem (a MESMA tag do servidor C, infra/jitsi/.env.example; update.sh --apply troca as duas juntas)
############

JITSI_IMAGE_REPO=ghcr.io/jitsi
JITSI_IMAGE_VERSION=stable-11248
# Hora de parede em UTC: o nome do arquivo gravado leva _aaaa-MM-dd-HH-mm-ss desse relogio (docs/30 §6.5).
TZ=UTC

############
# O servidor C (preenchido pelo jibri-up a partir do .env de la)
############

# IPv4 publico do servidor C: o Jibri fala XMPP com o prosody pela 5222, que o firewall de la abre so para
# o IP desta maquina. Por IP, nao por nome, para nao depender de DNS nem de IPv6.
XMPP_SERVER=
XMPP_PORT=5222
# Dominios XMPP internos, iguais aos do servidor C (nao sao nomes de DNS).
XMPP_DOMAIN=meet.jitsi
XMPP_AUTH_DOMAIN=auth.meet.jitsi
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.jitsi
XMPP_MUC_DOMAIN=muc.meet.jitsi
XMPP_HIDDEN_DOMAIN=hidden.meet.jitsi
# O certificado do prosody e interno (meet.jitsi): o Jibri confia nele.
XMPP_TRUST_ALL_CERTS=true
# Endereco publico do site do Jitsi: o Chrome do gravador abre a sala por aqui (https://meet.<dominio>).
PUBLIC_URL=
# Nome deste gravador na sala interna (o jibri-up poe o nome do servidor).
JIBRI_INSTANCE_ID=bunker707-jibri
# Contas XMPP do gravador: os MESMOS valores de JIBRI_XMPP_PASSWORD e JIBRI_RECORDER_PASSWORD do servidor C.
JIBRI_XMPP_USER=jibri
JIBRI_XMPP_PASSWORD=
JIBRI_RECORDER_USER=recorder
JIBRI_RECORDER_PASSWORD=
JIBRI_BREWERY_MUC=jibribrewery

############
# Gravacao (D26)
############

# 1080p a 30 quadros. Reserva do jibri-up quando so ha cpx32: 1280x720 (o admin avisa que o replay sai em 720p).
JIBRI_RECORDING_RESOLUTION=1920x1080
JIBRI_RECORDING_FRAMERATE=30
# Qualidade do H.264 (0 sem perdas, 51 pior; 23 e o padrao do ffmpeg) e o preset (ultrafast gasta menos CPU).
JIBRI_RECORDING_CONSTANT_RATE_FACTOR=25
JIBRI_RECORDING_VIDEO_ENCODE_PRESET_RECORDING=ultrafast
JIBRI_RECORDING_QUEUE_SIZE=4096
# 0 = o Jibri volta a ficar livre depois de cada gravacao (o host pode parar e gravar de novo na mesma live);
# 1 = uma gravacao so por container (precisaria reiniciar). A maquina ja e de uma sessao so.
JIBRI_SINGLE_USE_MODE=0
# Tempo maximo de uma gravacao (0 = sem limite; o jibri-down e o aviso de 6 h cuidam do servidor esquecido).
JIBRI_USAGE_TIMEOUT=0
# API HTTP do Jibri (saude em /jibri/api/v1.0/health), publicada so em 127.0.0.1.
JIBRI_HTTP_API_EXTERNAL_PORT=2222
JIBRI_HTTP_API_INTERNAL_PORT=3333
JIBRI_HEALTH_BIND=127.0.0.1

############
# O que o finalize.sh usa (docs/30 §5.3 e §6.7)
############

# Id da Sessao desta live (webinar_sessions.id): vai no corpo de todo aviso ao app.
SESSAO=
# Webhook do gravador no app e o segredo que assina X-Bunker-Signature (o mesmo WEBINAR_RECORDER_WEBHOOK_SECRET
# do servidor A). Do segredo JIBRI_SECRETS do repositorio; nunca no chat, nunca em `opcoes`.
WEBINAR_RECORDER_WEBHOOK_URL=https://membros.bunker707.com.br/api/webhooks/recorder
WEBINAR_RECORDER_WEBHOOK_SECRET=
# Biblioteca da Bunny Stream que recebe o MP4 (id numerico) e a chave de API dela; colecao opcional.
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_COLLECTION_ID=
