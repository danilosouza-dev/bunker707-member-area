############################################################################################
# Jitsi Meet proprio da Bunker707 (servidor C, bunker707-meet): variaveis de infra/jitsi/docker-compose.yml.
#
# NAO edite este arquivo com valores reais. Gere o .env com:
#   sh infra/jitsi/generate-secrets.sh --domain meet.bunker707.com.br --email voce@bunker707.com.br \
#       [--app-origin https://membros.bunker707.com.br] [--jwt-secret <o mesmo WEBINAR_JWT_SECRET do app>]
#   sh infra/jitsi/generate-secrets.sh --local        # ensaio na sua maquina
# O script gera as senhas, deriva os enderecos e grava .env (chmod 600), que o .gitignore ja ignora.
# Os nomes das variaveis sao os do env.example e dos templates da tag fixada do docker-jitsi-meet.
# Passo a passo em docs/20-runbook-hetzner.md, secao 8B, e o desenho em docs/30-webinarios.md, secao 6.2.
############################################################################################

############
# Imagens
############

# Registro das imagens (o oficial e o GHCR do projeto).
JITSI_IMAGE_REPO=ghcr.io/jitsi
# Tag stable fixada, a mesma nas quatro imagens e no Jibri (jibri/.env.example). Sobe so por
# infra/jitsi/scripts/update.sh (--check compara com a ultima stable; --apply troca aqui e no Jibri).
JITSI_IMAGE_VERSION=stable-11248

############
# Enderecos (derivados por generate-secrets.sh)
############

# Endereco publico do site do Jitsi, com https:// e sem barra no fim. O navegador do aluno e o Jibri abrem
# a sala por aqui; tambem define o websocket (wss://<host>/xmpp-websocket). Producao: https://meet.bunker707.com.br.
PUBLIC_URL=
# Caddy: hostname do site (dominio puro = HTTPS automatico pelo Let's Encrypt). Ensaio local: meet.127.0.0.1.sslip.io.
MEET_SITE_ADDRESS=
# Quem pode colocar a sala num iframe (cabecalho frame-ancestors): a origem da area de membros, separada por
# espaco se houver mais de uma. Vazio = ninguem (a sala nao abre dentro da nossa pagina).
MEET_FRAME_ANCESTORS=
# E-mail de avisos do Let's Encrypt.
ACME_EMAIL=
# Interface e portas do Caddy. Producao: 0.0.0.0 / 80 / 443. Ensaio local: 127.0.0.1 / 3080 / 3443.
CADDY_BIND=0.0.0.0
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# `local_certs` so no ensaio local (certificado da CA interna do Caddy, sem Let's Encrypt). Producao: vazio.
CADDY_LOCAL_CERTS=
# Hora de parede em UTC em todo servidor nosso (o nome do arquivo do Jibri leva esse relogio, docs/30 §6.5).
TZ=UTC

############
# Quem entra: so com o JWT emitido pelo nosso app (docs/30 §5.4 e §8.1)
############

# Autenticacao ligada, por token; sem convidado anonimo: ninguem entra pelo link (D14).
ENABLE_AUTH=1
AUTH_TYPE=jwt
ENABLE_GUESTS=0
# iss e aud do token; o app usa WEBINAR_JWT_APP_ID com o mesmo valor.
JWT_APP_ID=bunker707
JWT_ACCEPTED_ISSUERS=bunker707
JWT_ACCEPTED_AUDIENCES=bunker707
# Segredo HS256 do token (gerado; 64 hex). O app precisa do MESMO valor em WEBINAR_JWT_SECRET: ele chega aos
# dois servidores por envelope (docs/20 §8B.3), ou passe --jwt-secret ao gerar. Trocar derruba quem esta na sala.
JWT_APP_SECRET=
# O host vira moderador pelo token (context.user.moderator = true): modulo token_affiliation no MUC
# (copia versionada em infra/jitsi/prosody/plugins). bunker_room_guard (nosso, mesma pasta) recusa na entrada quem
# a equipe removeu ou baniu, mesmo com o token antigo. Mais de um modulo: separados por virgula.
XMPP_MUC_MODULES=token_affiliation,bunker_room_guard
# Onde o bunker_room_guard busca a lista de removidos e banidos (GET assinado com a chave derivada do JWT_APP_SECRET,
# a cada 5 s): <origem da area de membros>/api/webhooks/room-guard (derivado por generate-secrets.sh). Vazio: o
# modulo so avisa no log e o Remover/Banir dependem do token curto (15 min).
ROOM_GUARD_URL=
# O primeiro que entra NAO vira moderador (o aluno nunca manda na sala).
ENABLE_AUTO_OWNER=0

############
# Sala (docs/30 §6.2)
############

# Websocket XMPP (transporte recomendado) e sem chamada 1:1 (Webinario nunca e P2P).
ENABLE_XMPP_WEBSOCKET=1
ENABLE_P2P=0
# Sala de espera (lobby) disponivel: e a Sessao de pratica ate o host clicar "Comecar para todos" (D4).
ENABLE_LOBBY=1
# A nossa pagina e a entrada: sem pre-entrada, boas-vindas, pagina de saida nem salas separadas.
ENABLE_PREJOIN_PAGE=0
ENABLE_WELCOME_PAGE=0
ENABLE_CLOSE_PAGE=0
ENABLE_BREAKOUT_ROOMS=0
# Sem pedidos a terceiros (gravatar) e sem a pagina "abra no aplicativo" no celular (D2, LGPD).
ENABLE_THIRD_PARTY_REQUESTS=0
DISABLE_DEEP_LINKING=1
# Chat, enquetes e reacoes sao nossos (D5); o aluno nao abre menu sobre ninguem.
DISABLE_POLLS=1
DISABLE_REACTIONS=1
DISABLE_PRIVATE_CHAT=1
DISABLE_REMOTE_VIDEO_MENU=1
# Todo mundo entra mudo e com a camera desligada (D4): START_WITH_* e o botao de cada um; START_*_MUTED=1
# e a regra "a partir do 1o participante", por garantia.
START_WITH_AUDIO_MUTED=1
START_WITH_VIDEO_MUTED=1
START_AUDIO_MUTED=1
START_VIDEO_MUTED=1
# Idioma padrao da interface quando o navegador nao diz o dele (codigo do Jitsi para portugues do Brasil).
DEFAULT_LANGUAGE=ptBR

############
# Qualidade (D26): teto de captura 1080p; os tetos por papel vao no configOverwrite do iframe (docs/30 §6.3)
############

RESOLUTION=1080
RESOLUTION_MIN=180
RESOLUTION_WIDTH=1920
RESOLUTION_WIDTH_MIN=320
# Tela compartilhada de 5 a 30 quadros (mouse e escrita fluidos); 15 e a outra opcao do card Qualidade.
DESKTOP_SHARING_FRAMERATE_MIN=5
DESKTOP_SHARING_FRAMERATE_MAX=30
# Tetos de bitrate em bit/s por nivel: low 180p, standard 360p, high 720p, full 1080p (~4 Mbit/s no palco) e a
# tela compartilhada (screen). Valem para VP8, VP9 e AV1; o compose repete para cada codec.
VIDEOQUALITY_BITRATE_LOW=200000
VIDEOQUALITY_BITRATE_STANDARD=500000
VIDEOQUALITY_BITRATE_HIGH=1500000
VIDEOQUALITY_BITRATE_FULL=4000000
VIDEOQUALITY_BITRATE_SCREEN=4000000

############
# Gravacao (o Jibri roda em outro servidor, por hora: infra/jitsi/jibri e docs/20 §8B.5)
############

# Liga o botao Gravar e o dominio escondido do gravador no prosody e no jicofo.
ENABLE_RECORDING=1
# Contas XMPP do Jibri (senhas geradas; as MESMAS vao para o .env do servidor do Jibri pela etapa jibri-up).
JIBRI_XMPP_USER=jibri
JIBRI_XMPP_PASSWORD=
JIBRI_RECORDER_USER=recorder
JIBRI_RECORDER_PASSWORD=
# Sala interna em que os gravadores se anunciam e quanto o jicofo espera um Jibri atender.
JIBRI_BREWERY_MUC=jibribrewery
JIBRI_PENDING_TIMEOUT=90 seconds

############
# TURN (alunos em rede fechada): passo seguinte, docs/20 §8B.4. Com TURN_HOST vazio nada e anunciado.
############

# Host e portas do coturn quando ele existir (meet.<dominio>, 3478 e 5349; o firewall ja deixa passar).
TURN_HOST=
TURN_PORT=3478
TURNS_HOST=
TURNS_PORT=5349
TURN_TRANSPORT=udp,tcp
# Segredo compartilhado com o coturn (gerado agora para o coturn nascer com ele).
TURN_CREDENTIALS=

############
# Internos (nao mude sem ler docs/30 §6.2; o Jibri usa os mesmos dominios)
############

# Dominios XMPP internos (nao sao nomes de DNS): a sala, as contas de servico, as salas, as internas e o
# dominio escondido do gravador.
XMPP_DOMAIN=meet.jitsi
XMPP_AUTH_DOMAIN=auth.meet.jitsi
XMPP_MUC_DOMAIN=muc.meet.jitsi
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.jitsi
XMPP_HIDDEN_DOMAIN=hidden.meet.jitsi
# Nome do prosody na rede do compose e a porta XMPP.
XMPP_SERVER=xmpp.meet.jitsi
XMPP_PORT=5222
# Em que interface a 5222 sai do servidor, so para o Jibri da vez (o firewall da Hetzner limita a origem).
# Ensaio local: 127.0.0.1.
XMPP_PUBLIC_BIND=0.0.0.0
# Senhas das contas de servico (geradas; o stack nao sobe sem elas).
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
# Midia: porta UDP do JVB e o IPv4 publico do servidor a anunciar (o container esta atras do NAT do Docker;
# a etapa deploy-meet preenche). Varios IPs: separados por virgula.
JVB_PORT=10000
JVB_ADVERTISE_IPS=
JVB_BREWERY_MUC=jvbbrewery
# Portas de saude (so em 127.0.0.1; smoke.sh e status-meet leem).
JICOFO_REST_PORT=8888
# A saude interna do jicofo (/about/health); desligada, a rota responde 404 e o container fica unhealthy.
JICOFO_ENABLE_HEALTH_CHECKS=1
# A REST do jicofo ouvindo em 0.0.0.0 dentro do container, para a porta de 127.0.0.1 do servidor chegar nela.
JICOFO_ENABLE_REST=1
JVB_COLIBRI_PORT=8080
# IPv6 dentro dos containers desligado (a rede do compose e IPv4; de fora, o Caddy atende IPv6 pelo Docker).
ENABLE_IPV6=0
# Nivel de log do prosody.
LOG_LEVEL=info

############
# Memoria da JVM (cx23 de 4 GB, docs/30 §7.1): jvb ate 1,5 GB de heap (dezenas de alunos com camera), jicofo
# ate 512 MB (um palco por vez); com prosody, nginx, caddy e sistema (~600 MB) e o swap de 2 GB, cabe.
############

VIDEOBRIDGE_MAX_MEMORY=1536m
JICOFO_MAX_MEMORY=512m
