# Crontab do Mautic (usuario www-data no container mautic-cron). Montado em /opt/mautic/cron pelo compose;
# a imagem oficial usa este arquivo no lugar do modelo dela. Baseado em docker-mautic/common/templates/
# mautic_cron, com o envio de e-mails agendados (broadcasts) e a importacao ligados. Os comandos sao os da
# documentacao do Mautic (Cron jobs). Para desligar algo, comente a linha; o deploy-marketing recarrega o crontab.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
BASH_ENV=/tmp/cron.env

# Segmentos: recalcula quem entra e sai de cada segmento - a cada 15 min
0,15,30,45 * * * * php /var/www/html/bin/console mautic:segments:update 2>&1 | tee /tmp/stdout

# Campanhas: adiciona e remove contatos das campanhas - a cada 15 min, 5 min depois dos segmentos
5,20,35,50 * * * * php /var/www/html/bin/console mautic:campaigns:update 2>&1 | tee /tmp/stdout

# Campanhas: executa as acoes pendentes (enviar e-mail, esperar, marcar) - a cada 15 min, 10 min depois
10,25,40,55 * * * * php /var/www/html/bin/console mautic:campaigns:trigger 2>&1 | tee /tmp/stdout

# E-mails de segmento agendados (broadcasts) - a cada 5 min; o envio em si sai pelo mautic-worker
*/5 * * * * php /var/www/html/bin/console mautic:broadcasts:send 2>&1 | tee /tmp/stdout

# Fila de mensagens adiadas pelas regras de frequencia (limite de envios por contato) - a cada 5 min
2,7,12,17,22,27,32,37,42,47,52,57 * * * * php /var/www/html/bin/console mautic:messages:send 2>&1 | tee /tmp/stdout

# Importacoes de contatos em segundo plano (CSV grande) - a cada 3 min
*/3 * * * * php /var/www/html/bin/console mautic:import 2>&1 | tee /tmp/stdout

# Webhooks de saida (so se a fila de webhooks estiver em modo "command" na configuracao) - a cada 1 min
#* * * * * php /var/www/html/bin/console mautic:webhooks:process 2>&1 | tee /tmp/stdout

# Caixa monitorada (bounces por IMAP; nao usamos: o Resend e o SES avisam por webhook) - a cada 1 min
#* * * * * php /var/www/html/bin/console mautic:email:fetch 2>&1 | tee /tmp/stdout

# Base GeoLite2 da MaxMind (precisa de chave de licenca na configuracao) - a cada hora
#0 * * * * php /var/www/html/bin/console mautic:iplookup:download 2>&1 | tee /tmp/stdout

# Limpeza de dados antigos (apaga hits e logs com mais de 365 dias; ligar so depois de ler a documentacao)
#1 2 * * * php /var/www/html/bin/console mautic:maintenance:cleanup --days-old=365 2>&1 | tee /tmp/stdout
