############################################################################################
# Bunker707 na Hetzner: variaveis do stack (infra/compose/docker-compose.yml).
#
# NAO edite este arquivo com valores reais. Gere o .env com:
#   sh infra/compose/generate-secrets.sh --domain membros.bunker707.com.br \
#       --api-domain api.bunker707.com.br --studio-domain studio.bunker707.com.br \
#       --email voce@bunker707.com.br
#   sh infra/compose/generate-secrets.sh --local        # ensaio na sua maquina
# O script gera todos os segredos, deriva as URLs e grava .env (chmod 600), que o .gitignore ja ignora.
# Passo a passo e explicacao de cada bloco em docs/20-runbook-hetzner.md.
############################################################################################

############
# Segredos (gerados por generate-secrets.sh; vazios aqui de proposito)
############

# Senha de todos os papeis internos do Postgres (postgres, supabase_auth_admin, authenticator...).
POSTGRES_PASSWORD=
# Segredo simetrico legado (HS256), ainda usado internamente pelos servicos.
JWT_SECRET=
# Chaves legadas de API (JWTs HS256 de 5 anos): uso interno do stack (Studio, Storage, healthchecks).
ANON_KEY=
SERVICE_ROLE_KEY=
# Chaves novas, as que o app usa: a publicavel vai ao navegador; a secreta so ao servidor do app.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Par EC P-256 (assinatura dos tokens do Auth) e o JWKS correspondente (verificacao no PostgREST,
# Realtime, Storage e Functions). JSON numa linha so.
JWT_KEYS=
JWT_JWKS=
# JWTs ES256 pre-assinados que o Envoy entrega aos servicos no lugar das chaves sb_. Uso interno.
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
# Studio (basic auth no Envoy). Em producao o Caddy ainda restringe por IP (STUDIO_ALLOWED_IPS).
DASHBOARD_USERNAME=bunker707
DASHBOARD_PASSWORD=
# Realtime e Supavisor (>= 64 caracteres).
SECRET_KEY_BASE=
# Realtime: exatamente 16 caracteres.
REALTIME_DB_ENC_KEY=
# Supavisor: exatamente 32 caracteres.
VAULT_ENC_KEY=
# Studio <-> postgres-meta (>= 32 caracteres).
PG_META_CRYPTO_KEY=
# Endpoint S3 do Storage (nao usado pelo app, mas o Storage exige).
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=
# Token Bearer de POST /api/jobs/tick (pg_cron + pg_net). O mesmo valor vai ao Vault como
# jobs_tick_token; a URL vai como jobs_tick_url = http://app:3000/api/jobs/tick (docs/20).
JOBS_TICK_TOKEN=

############
# Enderecos (derivados dos dominios por generate-secrets.sh)
############

# Onde o aluno entra. Producao: https://membros.bunker707.com.br. Ensaio local: http://localhost:3080.
APP_PUBLIC_URL=
# Endereco publico do Supabase, igual para navegador e servidor do app (cookie sb-<host>-auth-token).
# Producao: https://api.bunker707.com.br. Ensaio local: http://127.0.0.1.sslip.io:8000 (nome publico
# que resolve para 127.0.0.1; dentro do container, extra_hosts leva ao proprio servidor).
SUPABASE_PUBLIC_URL=
# So o host de SUPABASE_PUBLIC_URL (entra em extra_hosts do app).
SUPABASE_PUBLIC_HOST=
# Auth: inclui o prefixo /auth/v1 (desde o self-hosted 0.7.0).
API_EXTERNAL_URL=
# GoTrue: Site URL e lista de redirecionamentos permitidos (so a callback do app, sem curinga).
SITE_URL=
ADDITIONAL_REDIRECT_URLS=

# Caddy: endereco de cada site. Dominio puro = HTTPS automatico (Let's Encrypt); com http:// nao ha TLS
# (ensaio local). O Caddy ignora a porta no casamento do Host.
APP_SITE_ADDRESS=
SUPABASE_SITE_ADDRESS=
STUDIO_SITE_ADDRESS=
# Quem pode abrir o Studio (CIDRs separados por espaco): o IP fixo do produtor, ou a saida do
# Cloudflare WARP/Access. O resto recebe 403 antes do basic auth.
STUDIO_ALLOWED_IPS=
# E-mail de avisos do Let's Encrypt.
ACME_EMAIL=
# Interface e portas do Caddy. Producao: 0.0.0.0 / 80 / 443. Ensaio local: 127.0.0.1 / 3080 / 3443.
CADDY_BIND=0.0.0.0
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# Porta do Envoy em 127.0.0.1 (depuracao no servidor; no ensaio local e por onde o navegador entra).
API_GW_HTTP_PORT=8000

############
# Banco e pooler (defaults do compose oficial)
############

POSTGRES_HOST=db
POSTGRES_DB=postgres
# Supavisor publica esta porta (sessao) e a de transacao, so em 127.0.0.1.
POSTGRES_PORT=5432
# Postgres direto (sem pooler), so em 127.0.0.1: migrate.sh, backup, psql de manutencao.
POSTGRES_DIRECT_PORT=5433
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
# Usuario no psql pelo pooler: postgres.<POOLER_TENANT_ID>
POOLER_TENANT_ID=bunker707
POOLER_DB_POOL_SIZE=5

############
# Studio
############

STUDIO_DEFAULT_ORGANIZATION=Bunker707
STUDIO_DEFAULT_PROJECT=Area de membros
# Opcional: assistente de IA do Studio.
OPENAI_API_KEY=

############
# Auth (espelha supabase/config.toml: plataforma fechada, e-mail e senha, minimo 8 caracteres)
############

JWT_EXPIRY=3600
# Sem cadastro publico; contas entram pelo admin (src/server/students/access.ts) ou por convite.
DISABLE_SIGNUP=true
# Provedor e-mail ligado (senao "Email logins are disabled" ate para contas criadas pelo admin).
ENABLE_EMAIL_SIGNUP=true
# Producao: false (convite confirma por link). Ensaio local sem SMTP: true.
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
AUTH_PASSWORD_MIN_LENGTH=8
# E-mails por hora que o Auth aceita enviar.
AUTH_RATE_LIMIT_EMAIL_SENT=30
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

# SMTP do Auth pelo Resend (porta 587: a Hetzner bloqueia 25 e 465 de saida). O remetente precisa ser
# do dominio verificado no Resend (mail.bunker707.com.br). SMTP_PASS = chave de envio do Resend.
SMTP_ADMIN_EMAIL=nao-responda@mail.bunker707.com.br
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
SMTP_SENDER_NAME=Bunker707

############
# Storage, Functions e PostgREST
############

GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub
IMGPROXY_AUTO_WEBP=true
FUNCTIONS_VERIFY_JWT=false
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions

############
# App Next.js (as mesmas variaveis do .env.example da raiz; detalhe la)
############

# Imagem a rodar. Vazio = bunker707-app:local, construida por `docker compose build app`.
# Producao: ghcr.io/danilosouza-dev/bunker707-member-area:sha-xxxxxxx (deploy.sh troca esta linha).
APP_IMAGE=
# Versao gravada na imagem quando o build e local (/api/health devolve).
APP_VERSION=local
# "user" (padrao) ou "claims" (valida o JWT pelo JWKS, sem ir ao Auth a cada request; ativar depois de
# conferir no ensaio local, docs/20).
AUTH_SESSION_STRATEGY=user
YOUTUBE_UNOFFICIAL_STREAMS=
ADMIN_DEMO_DATA=off
BUNKER_AI_GATEWAY_URL=
BUNKER_AI_GATEWAY_API_KEY=
BUNKER_AI_GATEWAY_MANAGEMENT_KEY=
# Observabilidade (opcional; tudo vazio = desligado). NEXT_PUBLIC_* tambem entram no build da imagem.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# E-mail transacional do app pela API do Resend (PR #80: boas-vindas e compra, fila email_outbox).
# EMAIL_PROVIDER=resend liga; RESEND_API_KEY pode ser a mesma chave de SMTP_PASS; RESEND_WEBHOOK_SECRET
# vem do endpoint de webhook criado no Resend apontando para APP_PUBLIC_URL/api/webhooks/resend.
EMAIL_PROVIDER=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

############
# Backup (infra/scripts/backup.sh; restic criptografa e envia a um Storage Box da Hetzner por SFTP)
############

# Storage Box: usuario uNNNNNN, host uNNNNNN.your-storagebox.de, SFTP na porta 23. backup.sh --init
# grava o alias `storagebox` em ~/.ssh/config e cria o repositorio.
STORAGE_BOX_USER=
STORAGE_BOX_HOST=
STORAGE_BOX_SSH_PORT=23
# Repositorio restic dentro do Storage Box.
RESTIC_REPOSITORY=sftp:storagebox:/bunker707/restic
# Senha do repositorio restic (gerada; guarde tambem fora do servidor: sem ela o backup nao abre).
RESTIC_PASSWORD=
# Retencao: um snapshot por dia pelos ultimos N dias.
BACKUP_KEEP_DAILY=30
