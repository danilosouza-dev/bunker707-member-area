# Borda da Bunker707 (infra/compose/docker-compose.yml, servico caddy). Tres sites, um por hostname:
#   APP_SITE_ADDRESS       o app Next.js (app:3000)
#   SUPABASE_SITE_ADDRESS  so os caminhos da API do Supabase (api-gw:8000); o resto responde 404
#   STUDIO_SITE_ADDRESS    Studio e postgres-meta pelo Envoy, so para STUDIO_ALLOWED_IPS; o Envoy exige
#                          o basic auth (DASHBOARD_USERNAME / DASHBOARD_PASSWORD)
#   MAUTIC_SITE_ADDRESS    so na colocacao do Mautic neste servidor (infra/mautic/compose.colocado.yml):
#                          o Mautic (mautic:80) com /installer restrito a STUDIO_ALLOWED_IPS. Sem Mautic
#                          aqui, o compose deixa http://mautic.invalid e o site nunca casa com pedido algum.
# Dominio puro no endereco = HTTPS automatico (Let's Encrypt, desafio HTTP-01, que passa pela Cloudflare
# em modo Full (strict)). http:// no endereco = sem TLS (ensaio local).
#
# A CSP com nonce por request, HSTS e os demais cabecalhos de seguranca do app vem do proprio Next
# (proxy.ts e next.config.ts): aqui nada e reescrito, so o cabecalho Server sai.

{
	email {$ACME_EMAIL}
	servers {
		# Atras da Cloudflare: o IP real vem em CF-Connecting-IP, aceito so das faixas dela.
		import /etc/caddy/cloudflare-trusted-proxies.caddyfile
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

(sem_server) {
	header -Server
}

{$APP_SITE_ADDRESS} {
	import sem_server
	encode zstd gzip
	reverse_proxy app:3000
}

{$SUPABASE_SITE_ADDRESS} {
	import sem_server
	header X-Content-Type-Options nosniff
	header Referrer-Policy no-referrer

	@api path /auth/v1/* /rest/v1/* /graphql/v1 /realtime/v1/* /storage/v1/* /functions/v1/* /.well-known/oauth-authorization-server/auth/v1
	handle @api {
		reverse_proxy api-gw:8000
	}

	# Modelos de e-mail do Auth em portugues (volumes/auth-templates): o GoTrue baixa pela URL ao enviar.
	handle_path /auth-templates/* {
		root * /srv/auth-templates
		file_server
	}

	# Studio, /pg (postgres-meta) e qualquer outro caminho: nao existem neste hostname.
	handle {
		respond 404
	}
}

{$STUDIO_SITE_ADDRESS} {
	import sem_server
	header X-Robots-Tag "noindex, nofollow"

	@permitido client_ip {$STUDIO_ALLOWED_IPS}
	handle @permitido {
		# O Envoy aplica o basic auth do painel (DASHBOARD_*) e encaminha / ao Studio e /pg ao meta.
		reverse_proxy api-gw:8000
	}

	handle {
		respond 403
	}
}

{$MAUTIC_SITE_ADDRESS} {
	import sem_server
	encode zstd gzip

	# O instalador web do Mautic aceitaria o primeiro visitante como administrador: fechado fora da
	# allowlist (a instalacao e por infra/mautic/scripts/install.sh). O Mautic le o IP real em
	# X-Forwarded-For e confia no Caddy (trusted_proxies = rede do compose).
	@instalador_permitido {
		path /installer /installer/*
		client_ip {$STUDIO_ALLOWED_IPS}
	}
	@instalador path /installer /installer/*
	handle @instalador_permitido {
		reverse_proxy mautic:80 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle @instalador {
		respond 403
	}
	handle {
		reverse_proxy mautic:80 {
			header_up X-Forwarded-For {client_ip}
		}
	}
}
