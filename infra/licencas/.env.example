# Variaveis do lado nosso no servidor do Emissor de licencas (infra/licencas/.env no servidor, 0600, dono deploy).
# O deploy-licencas escreve este arquivo sozinho (docs/20 §8C); aqui ficam so os nomes e exemplos. Valor de verdade
# nunca entra no repositorio. As variaveis do Emissor (as do compose.yaml dele) ficam em outro arquivo, o .env ao lado
# do compose.yaml do bunker-licensing, em /opt/bunker707/emissor.

# --- Borda (infra/licencas/docker-compose.yml, Caddy) ---------------------------------------------------------------
# Os dois nomes (lib.sh: LICENCAS_API_DOMAIN e LICENCAS_PAINEL_DOMAIN).
LICENCAS_API_DOMAIN=licencas-api.bunker707.com.br
LICENCAS_PAINEL_DOMAIN=licencas.bunker707.com.br
# Quem abre o Painel, alem do Cloudflare Access: IPs ou redes (no maximo /24 ou /48) separados por espaco. Vem de
# LICENCAS_PAINEL_IPS (virgula) ou PRODUCER_IP nas opcoes do deploy-licencas. Sem nenhum, ninguem abre.
LICENCAS_PAINEL_IPS=127.0.0.1/32
# As portas locais do Emissor e do Painel, copiadas do .env do compose do Emissor a cada deploy (os nomes e os padroes
# sao os do .env.example do bunker-licensing, docs/20 §8C.4). O Painel e a conta de envio do Emissor nao ficam aqui:
# vao para o .env do compose dele (docs/20 §8C.5).
EMISSOR_PORTA_NO_HOST=8080
PAINEL_PORTA_NO_HOST=8081
# E-mail do Let's Encrypt.
ACME_EMAIL=ferramentas.bunker707@gmail.com

# --- Backup (infra/licencas/scripts/backup.sh, de hora em hora) -----------------------------------------------------
# O Storage Box que ja existe (bunker707-backups), num repositorio so do Emissor.
RESTIC_REPOSITORY=sftp:storagebox:bunker707/restic-licencas
# Gerada no servidor pelo deploy-licencas; nunca sai dele. A segunda chave do repositorio e a de recuperacao,
# derivada do HCLOUD_TOKEN (docs/20 §10.2): sem este arquivo, o token abre o backup.
RESTIC_PASSWORD=
STORAGE_BOX_USER=
STORAGE_BOX_HOST=
STORAGE_BOX_SSH_PORT=23
# Retencao: os backups de hora em hora das ultimas 48 horas e um por dia dos ultimos 30 dias.
BACKUP_KEEP_HOURLY=48
BACKUP_KEEP_DAILY=30
# A hora (UTC) da limpeza pesada do repositorio (restic prune), uma vez por dia.
BACKUP_PRUNE_HOUR=03
# Opcional: endereco de "push" de um monitor (Better Stack, Uptime Kuma) chamado a cada backup bom.
BACKUP_HEARTBEAT_URL=
